{
    "name": "ragnarok-atlas",
    "private": true,
    "version": "1.0.0",
    "description": "Site estático do Ragnarök Atlas · LATAM (sem build).",
    "type": "module",
    "scripts": {
        "lint": "eslint app.js js",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "check": "node tools/checar_sintaxe.mjs",
        "validar:dados": "node tools/validar_dados.mjs",
        "test": "node --test tools/validar_dados.test.mjs",
        "snapshot": "node tools/snapshot.mjs",
        "versao": "node tools/versao_cache.mjs",
        "versao:verificar": "node tools/versao_cache.mjs --verificar"
    },
    "devDependencies": {
        "eslint": "^10.15.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.10.1"
    },
    "engines": {
        "node": ">=20"
    }
}
